# Configuração pública de origem; usar domínio estável de produção.
APP_URL=http://localhost:3000
# live ativa a central privada; demo mostra apenas dados fictícios.
HUB_MODE=demo
CLIENT_ID=
CLIENT_SECRET=
DATABASE_URL=
HUB_ADMIN_EMAIL=
HUB_ADMIN_PASSWORD_HASH=
TOKEN_ENCRYPTION_KEY=
# Apenas local, gerada por scripts/setup-local.mjs. Não enviar à Vercel.
HUB_ADMIN_PASSWORD=
# Credenciais do site Bling, usadas apenas no login oficial durante validação.
# A aplicação nunca lê estas duas variáveis; não enviar à Vercel.
BLING_EMAIL=
BLING_PASSWORD=
